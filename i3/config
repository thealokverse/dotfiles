# ╔══════════════════════════════════╗
# ║   i3 Config — Catppuccin Mocha  ║
# ╚══════════════════════════════════╝

# Modifier key (Super/Windows key)
set $mod Mod4

# ── Catppuccin Mocha Colors ─────────────────────────────
set $base     #1e1e2e
set $surface  #313244
set $overlay  #6c7086
set $text     #cdd6f4
set $lavender #b4befe
set $blue     #89b4fa
set $mauve    #cba6f7
set $pink     #f38ba8
set $teal     #94e2d5

# ── Font ────────────────────────────────────────────────
font pango:JetBrains Mono 10

# ── Gaps (the signature rice look) ──────────────────────
gaps inner 10
gaps outer 5
smart_gaps on
smart_borders on

# ── Window Colors ───────────────────────────────────────
# class                 border    bg        text      indicator child_border
client.focused          $mauve    $surface  $text     $mauve    $mauve
client.focused_inactive $surface  $base     $overlay  $surface  $surface
client.unfocused        $base     $base     $overlay  $base     $base
client.urgent           $pink     $pink     $base     $pink     $pink

# ── Remove title bars ───────────────────────────────────
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# ── Startup Apps ────────────────────────────────────────
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id feh --bg-fill ~/.wallpapers/wallpaper.png
exec --no-startup-id dunst
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
#exec --no-startup-id nm-applet
#exec --no-startup-id blueman-applet
exec --no-startup-id sleep 3 && eww daemon && sleep 2 && eww open sidebar

# ── Keybindings ─────────────────────────────────────────
# Terminal
bindsym $mod+Return exec alacritty

# App launcher (Rofi)
bindsym $mod+d exec rofi -show drun -theme ~/.config/rofi/catppuccin.rasi

# Kill window
bindsym $mod+q kill

# Reload / Restart i3
bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload

# Logout
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'

# Screenshot
bindsym Print exec flameshot gui

# Volume
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set 10%+
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Media
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# ── Focus Movement (Vim keys + arrows) ──────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ── Move Windows ────────────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ── Resize ──────────────────────────────────────────────
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym l resize grow width 10 px
    bindsym k resize shrink height 10 px
    bindsym j resize grow height 10 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ── Layout ──────────────────────────────────────────────
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# ── Workspaces ──────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5

# Eww widgets
bindsym $mod+shift+s exec ~/.config/eww/scripts/toggle-sidebar.sh
bindsym $mod+shift+p exec ~/.config/eww/scripts/toggle-power.sh
bindsym $mod+Escape  exec ~/.config/eww/scripts/toggle-power.sh
